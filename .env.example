# --- jev access: Option A, OpenRouter (what this project is set up for) ---
# Key from https://openrouter.ai/keys. Model ids stay bare ("jev-latest");
# OpenRouter maps them to its typesafe/ namespace.
OPENROUTER_API_KEY=

# --- jev access: Option B, TypeSafe directly ---
# Leave OPENROUTER_API_KEY empty and set this instead. Key from https://typesafe.ai
# TYPESAFE_API_KEY=

# --- SEC EDGAR (required for the screener) ---
# The SEC requires a descriptive User-Agent naming the operator, and blocks
# anonymous automated traffic. Put your own contact address here.
EDGAR_USER_AGENT=jevproject you@example.com

# --- Polygon (daily closes for valuation multiples) ---
# Free key from https://polygon.io/dashboard/api-keys. The free tier is end-of-day
# data, which is all this needs: one request returns every US ticker's close for a
# day, so a routine refresh costs a single call.
POLYGON_API_KEY=

# --- Optional overrides (defaults shown) ---
# TYPESAFE_BASE_URL=https://openrouter.ai/api
# TYPESAFE_DEFAULT_MODEL=jev-latest
# TYPESAFE_LOG_LEVEL=warn
